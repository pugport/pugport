{
  "name": "pugport",
  "productName": "PugPort",
  "version": "0.0.40",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "bin": {
    "pugport": "dist/cli/pugport.js"
  },
  "description": "Desktop agent with quota-aware native CLI scheduling",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ui": "node scripts/build.mjs --ui-only",
    "dev": "node --import tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "desktop": "electron .",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:ci": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mods:validate": "node --import tsx scripts/validate-mod.ts",
    "mods:pack": "node --import tsx scripts/pack-mod.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:desktop": "node scripts/package.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "verify:licenses": "node scripts/audit-dependency-licenses.mjs --check && node scripts/verify-license-bundle.mjs",
    "doctor": "node scripts/doctor.mjs",
    "version:patch": "node scripts/version.mjs patch",
    "setup:markitdown": "node scripts/setup-markitdown.mjs",
    "i18n": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "brand:electron": "node scripts/brand-electron.mjs",
    "postinstall": "node scripts/brand-electron.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "setup:image-search": "node scripts/setup-image-search.mjs",
    "setup:memory-search": "node scripts/setup-memory-search.mjs",
    "test:local-tools": "tsc --noEmit -p tests/local-tools/tsconfig.json && node --import tsx --test tests/local-tools/*.test.ts",
    "release:win": "node scripts/release-win.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@microsoft/mxc-sdk": "1.1.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@vscode/ripgrep": "1.18.0",
    "@xmldom/xmldom": "0.9.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "adm-zip": "0.6.1",
    "electron-updater": "6.8.11",
    "express": "5.3.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.79.0",
    "minisearch": "7.2.0",
    "node-pty": "1.1.0",
    "onnxruntime-node": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "sherpa-onnx-node": "1.13.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1177.0",
    "@aws-sdk/lib-storage": "3.1177.0",
    "@babel/parser": "7.29.15",
    "@electron/packager": "20.3.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "44.11.6",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "opencc-js": "1.4.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "license": "Apache-2.0"
}
